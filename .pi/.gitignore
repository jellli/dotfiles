# --- runtime / per-machine data (not config) ---
/agent/sessions/
node_modules/
/agent/auth.json
/agent/brave-search/
/agent/cache/
/agent/trust.json
tsconfig.json
!agent/extensions/codegraph/tsconfig.json

# Memory DBs (SQLite, high-churn, machine-local)
/agent/pi-hermes-memory/
/agent/projects-memory/
