{
  "quietStartup": true,
  "lastChangelogVersion": "0.85.0",
  "theme": "gruvbox-material",
  "defaultProvider": "jiji",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "high",
  "externalEditor": "tmux display-popup -w 90% -h 85% -E nvim",
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-mcp-adapter",
    "npm:pi-blackhole",
    "npm:pi-ollama-cloud"
  ],
  "skills": [
    "-skills/caveman-commit/SKILL.md",
    "-skills/caveman-review/SKILL.md",
    "-skills/vercel-react-best-practices/SKILL.md",
    "-skills/question-distiller.disabled/SKILL.md",
    "-skills/plan-mode/SKILL.md"
  ],
  "extensions": [
    "-extensions/commandcode.ts"
  ],
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": true
  },
  "doubleEscapeAction": "none",
  "tuiMode": "regular",
  "enabledModels": [
    "deepseek/deepseek-v4-flash",
    "jiji/gpt-5.6-luna",
    "ollama-cloud/deepseek-v4-flash:0731"
  ],
  "outputPad": 1,
  "terminal": {
    "showTerminalProgress": false
  }
}
