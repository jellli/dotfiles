# --- dotfiles top-level ignores ---
**/tmux/plugins

# --- LLM Wiki (pi-llm-wiki) ---
# Keep knowledge content (wiki/, raw/, templates/, config) in git; ignore
# auto-generated metadata, lint outputs, and discoveries cache.
.llm-wiki/meta/
.llm-wiki/outputs/
.llm-wiki/.discoveries/

# --- pi runtime state (not config) ---
.pi/agent/mcp-cache.json
.pi/agent/mcp-npx-cache.json
.pi/agent/models-store.json
.pi/agent/plannotator-enhancer.log
.pi/agent/pi-speeed-stats.json
